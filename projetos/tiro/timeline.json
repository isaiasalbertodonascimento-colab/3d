   "end": 17.301,
   "sentences": [
    {
     "text": "O cérebro inunda o corpo de adrenalina, que pode esconder a dor por vários minutos.",
     "start": 9.605,
     "end": 13.86
    },
    {
     "text": "Mas o perigo de verdade está acontecendo por dentro.",
