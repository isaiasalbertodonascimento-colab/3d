   ]
  },
  {
   "id": "sangue",
   "tag": "O SANGUE",
   "start": 18.096,
   "end": 25.401,
   "sentences": [
    {
     "text": "Um adulto tem cerca de cinco litros de sangue.",
     "start": 18.096,
     "end": 20.545
    },
    {
     "text": "E o coração, tentando compensar a perda, bate cada vez mais rápido.",
     "start": 21.344,
     "end": 25.401
    }
   ]
  },
  {
   "id": "defesa",
   "tag": "DEFESA",
   "start": 26.202,
   "end": 34.693,
   "sentences": [
    {
     "text": "Enquanto isso, as plaquetas correm até o ferimento e tentam fechar o vazamento, como um tampão.",
     "start": 26.202,
     "end": 31.294
    },
    {
     "text": "Só que, sozinhas, elas não dão conta.",
     "start": 32.113,
     "end": 34.693
    }
   ]
  },
  {
   "id": "verdade",
   "tag": "A VERDADE",
   "start": 35.507,
   "end": 41.893,
   "sentences": [
    {
     "text": "É por isso que apertar o ferimento e chamar socorro rápido salvam vidas.",
     "start": 35.507,
     "end": 39.29
    },
    {
     "text": "No trauma, cada minuto conta.",
