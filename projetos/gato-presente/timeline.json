  "gancho": "POR QUE SEU GATO<br>TE DÁ <em>PRESENTES?</em>",
  "final": "PARTE 3<br><em>AMANHÃ</em>"
 },
 "beats": [
  {
   "id": "gancho",
   "tag": "PARTE 2",
   "start": 0.8,
   "end": 8.925,
   "sentences": [
    {
     "text": "Seu gato deixa um bicho morto na sua porta e fica te olhando, todo orgulhoso.",
     "start": 0.8,
     "end": 5.904
    },
    {
     "text": "Isso é um presente?",
     "start": 6.126,
     "end": 7.592
    },
    {
     "text": "É quase isso.",
     "start": 8.006,
     "end": 8.925
    }
   ]
  },
  {
   "id": "instinto",
   "tag": "MOTIVO #1",
   "start": 9.44,
   "end": 15.002,
   "sentences": [
    {
     "text": "Para o cérebro dele, caçar e comer são coisas separadas.",
     "start": 9.44,
     "end": 13.473
    },
    {
     "text": "Mesmo de barriga cheia, o instinto manda caçar.",
     "start": 13.666,
     "end": 15.002
    }
   ]
  },
  {
   "id": "professor",
   "tag": "MOTIVO #2",
   "start": 15.322,
   "end": 25.595,
   "sentences": [
    {
     "text": "Uma teoria diz que ele está te ensinando.",
     "start": 15.322,
     "end": 19.485
    },
    {
     "text": "É o que as mães fazem com os filhotes.",
     "start": 19.748,
     "end": 21.98
    },
    {
     "text": "Ou seja, ele acha que você é um péssimo caçador.",
     "start": 22.163,
     "end": 25.595
    }
   ]
  },
  {
   "id": "seguro",
   "tag": "MOTIVO #3",
   "start": 26.035,
   "end": 33.103,
   "sentences": [
    {
     "text": "Outra explicação: sua casa é o lugar mais seguro que ele conhece.",
     "start": 26.035,
     "end": 30.447
    },
    {
     "text": "Então ele traz a presa para guardar.",
     "start": 30.968,
     "end": 33.103
    }
   ]
  },
  {
   "id": "ciencia",
   "tag": "O QUE FAZER",
   "start": 33.58,
   "end": 44.889,
   "sentences": [
    {
     "text": "Pesquisadores ingleses descobriram um truque.",
     "start": 33.58,
     "end": 36.05
    },
    {
     "text": "Brincar de caçada todo dia reduziu as presas em um quarto.",
     "start": 36.45,
     "end": 40.615
    },
    {
     "text": "E uma ração mais rica em carne reduziu em mais de um terço.",
     "start": 40.813,
     "end": 44.889
    }
   ]
  },
  {
   "id": "parte3",
   "tag": "PARTE 3",
   "start": 45.38,
   "end": 50.346,
   "sentences": [
    {
     "text": "Na parte três: por que ele te amassa como se fosse pão.",
     "start": 45.38,
     "end": 48.638
    },
    {
     "text": "Segue para não perder.",
     "start": 48.933,
     "end": 50.346
    }
   ]
  }
