 "beats": [
  {
   "id": "gancho",
   "tag": "",
   "start": 0.8,
   "end": 4.518,
   "sentences": [
    {
     "text": "E se você caísse num buraco negro?",
     "start": 0.8,
     "end": 2.625
    },
    {
     "text": "O Léo descobriu do pior jeito.",
     "start": 3.048,
     "end": 4.518
    }
   ]
  },
  {
   "id": "cabo",
   "tag": "",
   "start": 4.949,
   "end": 9.835,
   "sentences": [
    {
     "text": "Ele estava consertando a nave quando o cabo de segurança arrebentou.",
     "start": 4.949,
     "end": 7.843
    },
    {
     "text": "E a gravidade começou a puxar.",
     "start": 8.285,
     "end": 9.835
    }
   ]
  },
  {
   "id": "luz",
   "tag": "",
   "start": 10.29,
   "end": 13.265,
   "sentences": [
    {
     "text": "Um buraco negro puxa tão forte que nem a luz consegue escapar.",
     "start": 10.29,
     "end": 13.265
    }
   ]
  },
  {
   "id": "estica",
   "tag": "",
   "start": 13.667,
   "end": 24.104,
   "sentences": [
    {
     "text": "Perto de um buraco negro pequeno, os pés do Léo eram puxados com muito mais força do que a cabeça.",
     "start": 13.667,
     "end": 18.703
    },
    {
     "text": "Ele começou a esticar, igual a um fio de macarrão.",
     "start": 19.099,
     "end": 21.472
    },
    {
     "text": "Os cientistas chamam isso de espaguetificação.",
     "start": 21.895,
     "end": 24.104
    }
   ]
  },
  {
   "id": "tripulacao",
   "tag": "",
   "start": 24.535,
   "end": 32.63,
   "sentences": [
    {
     "text": "Enquanto isso, a tripulação olhava pela janela.",
     "start": 24.535,
     "end": 26.702
    },
    {
     "text": "Pra eles, o Léo ia ficando cada vez mais lento e mais vermelho, até parecer congelado na borda para sempre.",
     "start": 27.122,
     "end": 32.63
    }
   ]
  },
  {
   "id": "galaxia",
   "tag": "",
   "start": 33.076,
   "end": 38.343,
   "sentences": [
    {
     "text": "E esse monstro existe de verdade.",
     "start": 33.076,
     "end": 34.548
    },
    {
     "text": "No centro da nossa galáxia tem um com a massa de quatro milhões de sóis.",
     "start": 34.974,
     "end": 38.343
    }
   ]
  },
  {
   "id": "fim",
   "tag": "",
   "start": 38.769,
   "end": 40.796,
   "sentences": [
    {
     "text": "Você entraria?",
     "start": 38.769,
     "end": 39.574
    },
    {
     "text": "Comenta aí.",
     "start": 39.971,
     "end": 40.796
    }
   ]
  }
 ],
