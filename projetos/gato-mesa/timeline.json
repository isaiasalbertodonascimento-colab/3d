   "end": 28.893,
   "sentences": [
    {
     "text": "Mas especialistas apontam um motivo mais esperto.",
     "start": 21.913,
     "end": 25.158
    },
    {
     "text": "Ele aprendeu que, quando algo cai, você aparece.",
     "start": 25.453,
     "end": 28.893
    }
