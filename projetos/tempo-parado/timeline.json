 "beats": [
  {
   "id": "relogio",
   "tag": "",
   "start": 0.8,
   "end": 6.117,
   "sentences": [
    {
     "text": "Meu avô me deu um relógio velho.",
     "start": 0.8,
     "end": 3.183
    },
    {
     "text": "E disse: *nunca aperte esse botão*.",
     "start": 3.533,
     "end": 6.117
    }
   ]
  },
  {
   "id": "apertei",
   "tag": "",
   "start": 6.467,
   "end": 8.467,
   "sentences": [
    {
     "text": "Eu *apertei*.",
     "start": 6.467,
     "end": 8.467
    }
   ]
  },
  {
   "id": "parou",
   "tag": "",
   "start": 8.817,
   "end": 10.817,
   "sentences": [
    {
     "text": "E o mundo *parou*.",
     "start": 8.817,
     "end": 10.817
    }
   ]
  },
  {
   "id": "passaros",
   "tag": "",
   "start": 11.167,
   "end": 16.483,
   "sentences": [
    {
     "text": "Os pombos ficaram *presos no ar*.",
     "start": 11.167,
     "end": 13.617
    },
    {
     "text": "A água da fonte virou *escultura*.",
     "start": 13.967,
     "end": 16.483
    }
   ]
  },
  {
   "id": "menino",
   "tag": "",
   "start": 16.833,
   "end": 19.817,
   "sentences": [
    {
     "text": "Um menino ficou parado *no meio do pulo*.",
     "start": 16.833,
     "end": 19.817
    }
   ]
  },
  {
   "id": "feliz",
   "tag": "",
   "start": 20.167,
   "end": 23.483,
   "sentences": [
    {
     "text": "Eu achei que era o *melhor dia* da minha vida.",
     "start": 20.167,
     "end": 23.483
    }
   ]
  },
  {
   "id": "parede",
   "tag": "",
   "start": 23.833,
   "end": 28.9,
   "sentences": [
    {
     "text": "Até que eu tentei andar.",
     "start": 23.833,
     "end": 25.833
    },
    {
     "text": "E o ar estava duro como uma *parede*.",
     "start": 26.183,
     "end": 28.9
    }
   ]
  },
  {
   "id": "moleculas",
   "tag": "",
   "start": 29.25,
   "end": 35.7,
   "sentences": [
    {
     "text": "Se o tempo para, as moléculas do ar também param.",
     "start": 29.25,
     "end": 32.767
    },
    {
     "text": "Elas viram uma *muralha invisível*.",
     "start": 33.117,
     "end": 35.7
    }
   ]
  },
  {
   "id": "luz",
   "tag": "",
   "start": 36.05,
   "end": 41.9,
   "sentences": [
    {
     "text": "E tem pior: a luz também para.",
     "start": 36.05,
     "end": 38.3
    },
    {
     "text": "Sem luz chegando nos olhos, eu fiquei *cega*.",
     "start": 38.65,
     "end": 41.9
    }
   ]
  },
  {
   "id": "som",
   "tag": "",
   "start": 42.25,
   "end": 47.583,
   "sentences": [
    {
     "text": "Sem o ar se mexer, também não existe som.",
     "start": 42.25,
     "end": 45.233
    },
    {
     "text": "*Silêncio total*.",
     "start": 45.583,
     "end": 47.583
    }
   ]
  },
  {
   "id": "botao",
   "tag": "",
   "start": 47.933,
   "end": 53.2,
   "sentences": [
    {
     "text": "Eu apertei o botão de novo, desesperada.",
     "start": 47.933,
     "end": 50.85
    },
    {
     "text": "*Nada*.",
     "start": 51.2,
     "end": 53.2
    }
   ]
  },
  {
   "id": "ombro",
   "tag": "",
   "start": 53.55,
   "end": 56.867,
   "sentences": [
    {
     "text": "Então, no escuro, alguém tocou no *meu ombro*.",
     "start": 53.55,
     "end": 56.867
    }
   ]
  },
  {
   "id": "alguem",
   "tag": "",
   "start": 57.217,
   "end": 59.733,
   "sentences": [
    {
     "text": "Tinha mais alguém *fora do tempo*.",
     "start": 57.217,
     "end": 59.733
    }
   ]
  }
 ],
