   "sentences": [
    {
     "text": "Você acha que conhece o seu gato?",
     "start": 0.8,
     "end": 2.749
    },
    {
     "text": "Pense de novo.",
     "start": 3.162,
     "end": 4.97
    }
   ]
  },
  {
   "id": "visao",
   "tag": "FATO #1 · VISÃO",
   "start": 5.345,
   "end": 17.911,
   "sentences": [
    {
     "text": "No escuro, ele enxerga com seis vezes menos luz do que você precisa.",
     "start": 5.345,
     "end": 10.013
    },
    {
     "text": "Atrás dos olhos existe uma camada que reflete a luz.",
     "start": 10.557,
     "end": 14.165
    },
    {
     "text": "É por isso que eles brilham na noite.",
     "start": 14.386,
     "end": 17.911
    }
   ]
  },
  {
   "id": "miado",
   "tag": "FATO #2 · MIADO",
   "start": 18.2,
   "end": 28.352,
   "sentences": [
    {
     "text": "Gatos adultos quase não miam entre si.",
     "start": 18.2,
     "end": 20.253
    },
    {
     "text": "O miado é uma linguagem que eles desenvolveram para falar com humanos.",
     "start": 20.633,
     "end": 26.065
    },
    {
     "text": "Ou seja, para te manipular.",
     "start": 26.236,
     "end": 28.352
    }
   ]
  },
  {
   "id": "ronronar",
   "tag": "FATO #3 · RONRONAR",
   "start": 28.564,
   "end": 38.906,
   "sentences": [
    {
     "text": "O ronronar vibra numa frequência entre 25 e 150 hertz.",
     "start": 28.564,
     "end": 34.124
    },
    {
     "text": "Cientistas investigam se essa vibração ajuda o próprio corpo do gato a se recuperar.",
     "start": 34.435,
     "end": 38.906
    }
   ]
  },
  {
   "id": "doce",
   "tag": "FATO #4 · DOCE",
   "start": 39.116,
   "end": 48.113,
   "sentences": [
    {
     "text": "Seu gato não sente gosto de doce.",
     "start": 39.116,
     "end": 42.303
    },
    {
     "text": "Ele não tem o receptor para isso.",
     "start": 42.549,
     "end": 44.594
    },
    {
     "text": "Para ele, açúcar simplesmente não existe.",
     "start": 44.934,
     "end": 48.113
    }
   ]
  },
  {
   "id": "piscada",
   "tag": "FATO #5 · PISCADA",
   "start": 48.424,
   "end": 58.324,
   "sentences": [
    {
     "text": "Se ele te olha e pisca devagar, isso é confiança.",
     "start": 48.424,
     "end": 52.351
    },
    {
     "text": "Pesquisadores descobriram que, se você piscar devagar de volta, ele tende a se aproximar.",
     "start": 52.652,
     "end": 58.324
    }
   ]
  },
  {
   "id": "sono",
   "tag": "FATO #6 · SONO",
   "start": 58.638,
   "end": 66.704,
   "sentences": [
    {
     "text": "Ele dorme até 16 horas por dia.",
     "start": 58.638,
     "end": 61.414
    },
    {
     "text": "Mas, mesmo dormindo, ele está te observando.",
     "start": 61.877,
     "end": 65.372
    },
    {
     "text": "Agora mesmo.",
     "start": 65.731,
     "end": 66.704
    }
   ]
  },
  {
   "id": "fim",
   "tag": "E VOCÊ?",
   "start": 67.038,
   "end": 70.129,
   "sentences": [
    {
     "text": "Qual dessas você não sabia?",
