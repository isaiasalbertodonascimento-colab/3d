    { "id": "fisica", "narracao": "Mas não era magia. Era *física*.",
      "shots": [ { "cena": "rosto", "camera": "push_in", "args": { "expr": "concentrado", "bg": "interior" } }, { "cena": "grade", "camera": "orbit", "impacto": true, "args": { "modo": "plana" } } ] },
    { "id": "einstein", "narracao": "Pra Einstein, a gravidade nem é uma força. É o *espaço-tempo* curvado.",
      "shots": [ { "cena": "grade", "camera": "push_in", "args": { "modo": "plana" } }, { "cena": "grade", "camera": "static", "impacto": true, "args": { "modo": "planeta" } }, { "cena": "grade", "camera": "orbit", "args": { "modo": "planeta" } } ] },
    { "id": "lencol", "narracao": "Coisas com muita massa afundam o espaço-tempo, como uma bola pesada num *lençol esticado*.",
      "shots": [ { "cena": "tecido", "camera": "push_in", "args": { "modo": "bola" } }, { "cena": "tecido", "camera": "static", "impacto": true, "args": { "modo": "bola", "close": true } }, { "cena": "tecido", "camera": "orbit", "args": { "modo": "bola" } } ] },
    { "id": "cai", "narracao": "E tudo ao redor *cai* pra dentro da curva.",
