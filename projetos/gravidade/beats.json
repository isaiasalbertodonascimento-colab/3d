    { "id": "proposito", "narracao": "Eu só fazia isso *de propósito*.",
      "shots": [ { "cena": "grade", "camera": "push_in", "impacto": true, "args": { "modo": "mao" } }, { "cena": "mao", "camera": "static", "args": { "bg": "grade", "forca": 1 } } ] },
    { "id": "treino", "narracao": "Fugi pra floresta e comecei a *treinar*.",
      "shots": [ { "cena": "estrada", "camera": "push_in" }, { "cena": "floresta", "camera": "pull_out", "args": { "acao": "wide" } } ] },
    { "id": "evolui", "narracao": "Primeiro, *pedras*. Depois, *troncos*. Depois... *eu mesmo*.",
      "shots": [ { "cena": "floresta", "camera": "push_in", "args": { "acao": "pedra" } }, { "cena": "rosto", "camera": "static", "args": { "expr": "concentrado", "bg": "floresta" } }, { "cena": "floresta", "camera": "static", "impacto": true, "args": { "acao": "tronco" } }, { "cena": "floresta", "camera": "tilt_up", "impacto": true, "args": { "acao": "voa" } }, { "cena": "rosto", "camera": "push_in", "args": { "expr": "risada", "bg": "floresta" } } ] },
    { "id": "noite", "narracao": "Até que uma noite, eu senti o espaço *tremer*.",
      "shots": [ { "cena": "vila", "camera": "push_in", "args": { "acao": "noite" } }, { "cena": "rosto", "camera": "static", "impacto": true, "args": { "expr": "medo", "bg": "noite" } } ] },
    { "id": "alguem", "narracao": "Tinha mais alguém curvando a *gravidade*.",
      "shots": [ { "cena": "torre", "camera": "push_in", "args": { "acao": "janela" } }, { "cena": "torre", "camera": "static", "impacto": true, "args": { "acao": "figura" } } ] },
    { "id": "nome", "narracao": "E ele *sabia meu nome*.",
      "shots": [ { "cena": "torre", "camera": "push_in", "impacto": true, "args": { "acao": "olhos" } }, { "cena": "rosto", "camera": "push_in", "args": { "expr": "medo", "bg": "noite" } } ] }
  ]
}
