{
  "titulo": "Renasci na Idade Média com o poder da gravidade",
  "titulos": { "final": "CONTINUA<em>...</em>" },
  "beats": [
    { "id": "morte", "narracao": "Eu morri do jeito mais *ridículo* possível. Escorreguei numa *casca de banana*.",
      "shots": [ { "cena": "cidade", "camera": "push_in", "args": { "acao": "anda" } }, { "cena": "cidade", "camera": "static", "args": { "acao": "banana" } }, { "cena": "cidade", "camera": "static", "impacto": true, "args": { "acao": "escorrega" } }, { "cena": "rosto", "camera": "push_in", "args": { "expr": "surpresa", "bg": "cidade" } }, { "cena": "ceu", "camera": "pull_out" } ] },
    { "id": "1347", "narracao": "E acordei em *1347*.",
