    { "id": "veio", "narracao": "Mas alguma coisa *veio comigo*.",
      "shots": [ { "cena": "interior", "camera": "push_in", "args": { "acao": "vela" } }, { "cena": "mao", "camera": "push_in", "args": { "bg": "interior", "forca": 0.35 } } ] },
    { "id": "maca", "narracao": "Eu estiquei a mão pra pegar uma maçã... e ela veio *direto na mão*.",
      "shots": [ { "cena": "interior", "camera": "static", "args": { "acao": "maca", "ini": 0, "fim": 0.15 } }, { "cena": "mao", "camera": "push_in", "args": { "bg": "interior", "forca": 1 } }, { "cena": "interior", "camera": "static", "impacto": true, "args": { "acao": "maca", "ini": 0.15, "fim": 1 } }, { "cena": "rosto", "camera": "push_in", "args": { "expr": "surpresa", "bg": "interior" } } ] },
    { "id": "curvar", "narracao": "Eu conseguia *curvar a gravidade*.",
      "shots": [ { "cena": "interior", "camera": "orbit", "args": { "acao": "objetos" } }, { "cena": "rosto", "camera": "push_in", "args": { "expr": "risada", "bg": "interior" } } ] },
    { "id": "bruxaria", "narracao": "Só que os aldeões viram tudo. *BRUXARIA!*",
