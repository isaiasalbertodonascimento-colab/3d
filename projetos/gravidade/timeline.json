 "beats": [
  {
   "id": "morte",
   "tag": "",
   "start": 0.8,
   "end": 6.85,
   "sentences": [
    {
     "text": "Eu morri do jeito mais *ridículo* possível.",
     "start": 0.8,
     "end": 3.917
    },
    {
     "text": "Escorreguei numa *casca de banana*.",
     "start": 4.267,
     "end": 6.85
    }
   ]
  },
  {
   "id": "1347",
   "tag": "",
   "start": 7.2,
   "end": 9.2,
   "sentences": [
    {
     "text": "E acordei em *1347*.",
     "start": 7.2,
     "end": 9.2
    }
   ]
  },
  {
   "id": "sem",
   "tag": "",
   "start": 9.55,
   "end": 16.25,
   "sentences": [
    {
     "text": "Sem celular.",
     "start": 9.55,
     "end": 11.55
    },
    {
     "text": "Sem internet.",
     "start": 11.9,
     "end": 13.9
    },
    {
     "text": "Sem *banho*.",
     "start": 14.25,
     "end": 16.25
    }
   ]
  },
  {
   "id": "veio",
   "tag": "",
   "start": 16.6,
   "end": 18.917,
   "sentences": [
    {
     "text": "Mas alguma coisa *veio comigo*.",
     "start": 16.6,
     "end": 18.917
    }
   ]
  },
  {
   "id": "maca",
   "tag": "",
   "start": 19.267,
   "end": 24.517,
   "sentences": [
    {
     "text": "Eu estiquei a mão pra pegar uma maçã...",
     "start": 19.267,
     "end": 22.117
    },
    {
     "text": "e ela veio *direto na mão*.",
     "start": 22.467,
     "end": 24.517
    }
   ]
  },
  {
   "id": "curvar",
   "tag": "",
   "start": 24.867,
   "end": 27.383,
   "sentences": [
    {
     "text": "Eu conseguia *curvar a gravidade*.",
     "start": 24.867,
     "end": 27.383
    }
   ]
  },
  {
   "id": "bruxaria",
   "tag": "",
   "start": 27.733,
   "end": 32.267,
   "sentences": [
    {
     "text": "Só que os aldeões viram tudo.",
     "start": 27.733,
     "end": 29.917
    },
    {
     "text": "*BRUXARIA!*",
     "start": 30.267,
     "end": 32.267
    }
   ]
  },
  {
   "id": "fisica",
   "tag": "",
   "start": 32.617,
   "end": 36.967,
   "sentences": [
    {
     "text": "Mas não era magia.",
     "start": 32.617,
     "end": 34.617
    },
    {
     "text": "Era *física*.",
     "start": 34.967,
     "end": 36.967
    }
   ]
  },
  {
   "id": "einstein",
   "tag": "",
   "start": 37.317,
   "end": 42.767,
   "sentences": [
    {
     "text": "Pra Einstein, a gravidade nem é uma força.",
     "start": 37.317,
     "end": 40.367
    },
    {
     "text": "É o *espaço-tempo* curvado.",
     "start": 40.717,
     "end": 42.767
    }
   ]
  },
  {
   "id": "lencol",
   "tag": "",
   "start": 43.117,
   "end": 49.367,
   "sentences": [
    {
     "text": "Coisas com muita massa afundam o espaço-tempo, como uma bola pesada num *lençol esticado*.",
     "start": 43.117,
     "end": 49.367
    }
   ]
  },
  {
   "id": "cai",
   "tag": "",
   "start": 49.717,
   "end": 52.767,
   "sentences": [
    {
     "text": "E tudo ao redor *cai* pra dentro da curva.",
     "start": 49.717,
     "end": 52.767
    }
   ]
  },
  {
   "id": "proposito",
   "tag": "",
   "start": 53.117,
   "end": 55.5,
   "sentences": [
    {
     "text": "Eu só fazia isso *de propósito*.",
     "start": 53.117,
     "end": 55.5
    }
   ]
  },
  {
   "id": "treino",
   "tag": "",
   "start": 55.85,
   "end": 58.767,
   "sentences": [
    {
     "text": "Fugi pra floresta e comecei a *treinar*.",
     "start": 55.85,
     "end": 58.767
    }
   ]
  },
  {
   "id": "evolui",
   "tag": "",
   "start": 59.117,
   "end": 68.167,
   "sentences": [
    {
     "text": "Primeiro, *pedras*.",
     "start": 59.117,
     "end": 61.117
    },
    {
     "text": "Depois, *troncos*.",
     "start": 61.467,
     "end": 63.467
    },
    {
     "text": "Depois...",
     "start": 63.817,
     "end": 65.817
    },
    {
     "text": "*eu mesmo*.",
     "start": 66.167,
     "end": 68.167
    }
   ]
  },
  {
   "id": "noite",
   "tag": "",
   "start": 68.517,
   "end": 71.833,
   "sentences": [
    {
     "text": "Até que uma noite, eu senti o espaço *tremer*.",
     "start": 68.517,
     "end": 71.833
    }
   ]
  },
  {
   "id": "alguem",
   "tag": "",
   "start": 72.183,
   "end": 75.167,
   "sentences": [
    {
     "text": "Tinha mais alguém curvando a *gravidade*.",
     "start": 72.183,
     "end": 75.167
    }
   ]
  },
  {
   "id": "nome",
   "tag": "",
   "start": 75.517,
   "end": 77.517,
   "sentences": [
    {
     "text": "E ele *sabia meu nome*.",
     "start": 75.517,
     "end": 77.517
    }
   ]
  }
 ],
